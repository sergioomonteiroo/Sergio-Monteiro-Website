---
import { profile, education } from "../data/profile";
const featuredEducation = education.filter((e) => e.featured);
---
<section class="intro-section">
  <div class="mx-auto grid w-full max-w-6xl gap-8 px-6 py-10 md:grid-cols-[1.35fr_1fr] md:gap-x-16 md:gap-y-8 md:py-9">
    <div>
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-sunset">{profile.subtitle} · AJT · {profile.location}</p>
      <h2 class="mt-3 max-w-xl font-display text-3xl font-semibold leading-tight tracking-tight text-apple-ink sm:text-4xl">{profile.role}</h2>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-apple-ink-2 sm:text-base" set:html={profile.pitch}></p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`mailto:${profile.email}`} class="inline-flex items-center gap-3 rounded-full bg-white px-5 py-3 text-sm font-semibold text-space-950 transition hover:bg-ink-200">Get in touch <span aria-hidden="true">↗</span></a>
        <a href="/cv.pdf" class="sunset-button inline-flex items-center gap-3 rounded-full px-5 py-3 text-sm font-semibold transition">Download CV <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <figure class="mx-auto w-full max-w-[340px] self-center md:col-start-2 md:row-span-2 md:row-start-1 md:justify-self-end">
      <div class="aspect-[4/5] overflow-hidden rounded-2xl border border-apple-border bg-surface apple-card-shadow">
        <img src={profile.headshot} alt={`Portrait of ${profile.name}`} width="480" height="600" loading="eager" decoding="async" class="h-full w-full object-cover object-center" />
      </div>
      <figcaption class="relative mx-4 -mt-8 rounded-xl border border-apple-border bg-surface px-4 py-3 apple-card-shadow">
        <p class="font-mono text-[10px] uppercase tracking-wider text-sunset">Currently</p>
        <p class="mt-1 font-display text-sm font-semibold leading-tight text-apple-ink">{profile.currentPosition.title}</p>
        <p class="mt-1 font-mono text-xs text-apple-ink-2">{profile.currentPosition.company}</p>
      </figcaption>
    </figure>
    <div class="border-t border-apple-border pt-6 md:col-start-1">
      <p class="font-display text-xl sm:text-2xl font-semibold tracking-tight text-flame-500">Embry-Riddle Graduate</p>
      <p class="mt-3 font-display text-xl font-medium leading-snug text-apple-ink">{profile.eyebrow.badge}</p>
      <p class="mt-2 text-sm leading-relaxed text-apple-ink-2">NAIA Scholar-Athlete · 100% Merit-Funded</p>
  <!-- Credential cards -->
  <div class="mt-5">
    <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
      {featuredEducation.map((e) => (
        <article class="relative overflow-hidden rounded-xl border border-apple-border bg-surface p-4 apple-card-shadow transition hover:-translate-y-0.5 hover:border-apple-border-mid">
          <div class="flex items-start gap-3">
            <div class="min-w-0">
              <p class="font-mono text-xs text-apple-ink-3">{e.years}</p>
              <h3 class="mt-0.5 font-display text-sm font-semibold text-apple-ink leading-snug">{e.title}</h3>
              <p class="mt-1 font-mono text-xs text-apple-ink-2">{e.school}</p>
              {e.schoolTagline && (
                <p class="mt-0.5 font-display text-[12px] italic text-flame-600 leading-snug">{e.schoolTagline}</p>
              )}
              <p class="mt-0.5 font-mono text-[11px] text-apple-ink-3">{e.location}</p>
              <div class="mt-2 flex flex-wrap gap-1.5">
                {e.gpa && (
                  <span class="inline-block rounded-md bg-flame-500/8 border border-flame-500/20 px-2 py-0.5 font-mono text-[11px] text-flame-600">GPA {e.gpa}</span>
                )}
                {e.heroBadges?.map((b) => (
                  <span class="inline-block rounded-md bg-apple-ink/5 border border-apple-border px-2 py-0.5 font-mono text-[11px] text-apple-ink-2">{b}</span>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
      <p class="mb-3 mt-6 font-mono text-[10px] uppercase tracking-wider text-apple-ink-3">Member of</p>
      <div class="inline-flex flex-wrap items-center gap-4 rounded-xl bg-white px-4 py-3">
        {profile.memberships.map((m) => (
          <img src={m.logo} alt={m.full} title={m.full} loading="lazy" decoding="async" class="h-8 w-auto max-w-24 object-contain sm:h-9" />
        ))}
      </div>
    </div>
  </div>

</section>

<div class="section-rule" aria-hidden="true"></div>
